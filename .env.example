# ================================================================
# VoiceAI BD - Server Environment Configuration
# ================================================================
# NOTE: DO NOT commit real API keys or secrets to this file or repository.
# Real secrets must be configured in the server environment (e.g., Cloud Run / AI Studio Secrets panel).

# Google Gemini API Key for AI Agent instruction generation & voice conversation engine
GEMINI_API_KEY=

# Configurable Gemini Model (defaults to gemini-3.8-flash if omitted)
GEMINI_MODEL=gemini-3.8-flash

# ElevenLabs API Key for real hyper-realistic text-to-speech & voices catalog
ELEVENLABS_API_KEY=

# Vapi API Configuration for Real-Time Conversational AI Voice Calling
VAPI_PRIVATE_KEY=
VAPI_API_KEY=
VITE_VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=

# Server & Host configuration (port 3000 is required by the container infrastructure)
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
